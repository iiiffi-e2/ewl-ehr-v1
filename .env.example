# Application Configuration
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
ENABLE_SWAGGER=true
PUBLIC_URL=http://localhost:8080

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ewl
# Redis
REDIS_URL=redis://localhost:6379

# ALIS API Configuration
ALIS_API_BASE=https://api.alisonline.com
ALIS_TEST_USERNAME=eye-watch-live@appstoresandbox
ALIS_TEST_PASSWORD=5z65rGwpY308kAB

# Webhook Authentication
WEBHOOK_BASIC_USER=ewl-alis-webhook-service
WEBHOOK_BASIC_PASS='Vy3@kR9#wL5$xP2qT8mN4cB7zA6dF1h'

# Caspio Configuration
CASPIO_TOKEN_URL=https://your-account.caspio.com/oauth/token
CASPIO_CLIENT_ID=your_caspio_client_id
CASPIO_CLIENT_SECRET=your_caspio_client_secret
CASPIO_TABLE_ENDPOINT=https://your-account.caspio.com/rest/v2/tables/YourTableName
CASPIO_SCOPE=resources:all

# Optional Configuration
# IP_ALLOWLIST=127.0.0.1,192.168.1.0/24
# WORKER_CONCURRENCY=5
# REQUEST_TIMEOUT_MS=15000

# Yardi HL7 Restful Message Broker (poll)
YARDI_HL7_POLL_ENABLED=false
YARDI_HL7_POLL_INTERVAL_MS=300000
YARDI_HL7_POLL_MAX_MESSAGES=50
YARDI_HL7_GET_MESSAGE_URL=https://test.yardimirthus.com:1021/HL7/GetMessage
YARDI_HL7_PROCESS_ACK_URL=https://test.yardimirthus.com:1024/HL7/ProcessACK/
YARDI_HL7_MAILBOX_PASSWORD=
# Role identity for Yardi HL7 broker (GetMessage MSH ends up as
# EyeWatchLive|EyeWatchLive|Yardi|EYELIVE; ProcessACK keeps Pharmacy=EyeWatchLive)
YARDI_HL7_SENDING_APPLICATION=Yardi
YARDI_HL7_SENDING_FACILITY=EYELIVE
YARDI_HL7_RECEIVING_APPLICATION=EyeWatchLive
YARDI_HL7_RECEIVING_FACILITY=EyeWatchLive
